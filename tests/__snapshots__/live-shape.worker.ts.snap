"# Flacier · 手机分流
# 配套节点订阅在首页更新；此配置负责分流与 DNS，不包含节点账号密码。
# 代理流量和加密 DNS 跟随首页所选节点，国内应用按 DIRECT 规则直连。
# 更新规则或 DNS 时，长按此配置选择 Update，并保持该配置为已选中状态。
[General]
ipv6 = false
prefer-ipv6 = false
dns-server = https://1.1.1.1/dns-query#proxy
direct-dns-server = https://223.5.5.5/dns-query, https://1.12.12.12/dns-query
fallback-dns-server = https://1.1.1.1/dns-query#proxy
proxy-dns-server = system
dns-direct-system = false
always-ip-address = true
use-local-host-item-for-proxy = true
udp-policy-not-supported-behaviour = REJECT
close-if-proxy-chain-missing = true

[Rule]
