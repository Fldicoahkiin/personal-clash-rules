rules:
  - AND,((IP-CIDR,203.0.113.10/32,no-resolve),(DST-PORT,9004)),DIRECT
  - AND,((IP-CIDR,198.51.100.11/32,no-resolve),(DST-PORT,5782)),DIRECT
  - AND,((DOMAIN-SUFFIX,anthropic.com),(NETWORK,UDP)),REJECT
  - DOMAIN-SUFFIX,anthropic.com,🧠 Claude
