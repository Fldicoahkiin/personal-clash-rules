{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "personal-clash-rules",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // SHA-256 (base64url) of the token the VPS sends to /api/vps-usage; the token itself stays on the VPS.
    "VPS_USAGE_TOKEN_SHA256": "75SXLX5XKuBXzKcSNN1ZlhjzR6ue9joLAz8SS2t1l_A"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "SUBSCRIPTIONS",
      "id": "c228ec8a42134d509e29b341b045f8ad"
    }
  ],
  "ratelimits": [
    {
      "name": "SUBSCRIPTION_RATE_LIMITER",
      "namespace_id": "83740621",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 0.01
    }
  }
}
