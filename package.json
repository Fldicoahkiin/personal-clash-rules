{
  "name": "personal-clash-rules",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "WRANGLER_SEND_METRICS=false WRANGLER_LOG_PATH=.wrangler.log wrangler dev --local --ip 127.0.0.1 --port 8789",
    "start:local": "node scripts/local-server.mjs",
    "rola": "node scripts/rola.mjs",
    "build": "pnpm cf-typegen && tsc -b && vite build",
    "sync:rules": "node scripts/sync-rules.mjs && pnpm sync:formats",
    "sync:formats": "node scripts/build-rule-formats.mjs",
    "test": "vitest run",
    "test:worker": "WRANGLER_SEND_METRICS=false WRANGLER_LOG_PATH=.wrangler.log vitest run --config vitest.worker.config.ts",
    "test:watch": "vitest",
    "typecheck": "pnpm cf-typegen && tsc -b --pretty false",
    "cf-typegen": "WRANGLER_SEND_METRICS=false WRANGLER_LOG_PATH=.wrangler.log node node_modules/wrangler/bin/wrangler.js types worker-configuration.d.ts --config ./wrangler.jsonc --install-skills=false",
    "check": "pnpm test && pnpm typecheck && pnpm build && pnpm test:worker"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "json5": "^2.2.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "undici": "7.29.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "esbuild": "0.28.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
