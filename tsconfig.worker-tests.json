{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "lib": ["ES2023", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["@cloudflare/vitest-plugin/types"]
  },
  "include": [
    "src/local/rola.ts",
    "tests/worker.integration.ts",
    "tests/*.worker.ts",
    "tests/helpers/*.ts",
    "tests/worker.setup.ts",
    "vitest.worker.config.ts",
    "worker-configuration.d.ts",
    "src/worker.ts",
    "src/worker/**/*.ts",
    "src/app/lib/rule-matcher.ts",
    "src/config/**/*.ts"
  ]
}
