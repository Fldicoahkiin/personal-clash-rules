{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vitest/globals", "vite/client"],
    "jsx": "react-jsx"
  },
  "include": [
    "public/rules/sing-box/ai-anthropic.json",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.worker.config.ts",
    "tests/**/*.test.ts",
    "worker-configuration.d.ts",
    "src/worker/**/*.ts",
    "src/local/**/*.ts",
    "src/app",
    "src/config/**/*.ts"
  ]
}
