{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "lib": ["ES2023", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "public/rules/sing-box/ai-anthropic.json",
    "src/worker.ts",
    "src/worker/**/*.ts",
    "src/config/**/*.ts",
    "worker-configuration.d.ts"
  ]
}
